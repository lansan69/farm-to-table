RewriteEngine Off
RewriteBase /farm-to-table/

RewriteCond %{REQUEST_URI} !^/dashboard/farm-to-table/public/
RewriteRule ^$ public/index.html [L]

RewriteCond %{REQUEST_URI} !^/dashboard/farm-to-table/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/$1 [L]
