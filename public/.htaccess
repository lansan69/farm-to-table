Options -Indexes
RewriteEngine On

RewriteBase /dashboard/farm-to-table/public/

# Deja pasar archivos y carpetas reales (js, css, components, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Todo lo demás (rutas SPA como /login, /farmers) va a index.html
RewriteRule ^ index.html [L]
